# OpenAI
OPENAI_API_KEY=sk-...

# Telegram bot tokens — one per agent, created via @BotFather
NIHILIST_BOT_TOKEN=...
EXISTENTIALIST_BOT_TOKEN=...
ABSURDIST_BOT_TOKEN=...

# Telegram group chat ID (negative number, e.g. -1001234567890)
GROUP_CHAT_ID=-1001234567890

# Agent response timing (seconds)
RESPONSE_DELAY_MIN=3
RESPONSE_DELAY_MAX=8

# How many recent messages each agent sees as context
CONTEXT_WINDOW=20

# SQLite database path
DB_PATH=./data/conversations.db

# ChromaDB persistence directory
CHROMA_PATH=./data/chroma

# Directory containing source text files (.txt)
TEXTS_PATH=./texts
